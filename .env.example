# ─── Supabase (required) ────────────────────────────────────────────────────
# Copy these from your Supabase project → Settings → API.
# In Vercel: Project → Settings → Environment Variables → add all 4 below.

# Server-side only (not exposed to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Client-side (Vite replaces these at build time, safe to be public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── Nitro / deployment target (optional) ───────────────────────────────────
# Override the Nitro preset.  Leave unset to use the default ("vercel").
# NITRO_PRESET=vercel
